NODE_ENV=development
PORT=4000

# comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
APP_BASE_URL=http://localhost:5500/frontend/auth
API_BASE_URL=http://localhost:4000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=workreport_auth
MYSQL_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=replace_with_64char_access_secret
JWT_REFRESH_SECRET=replace_with_64char_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REMEMBER_REFRESH_EXPIRES_IN=60d

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BCRYPT_SALT_ROUNDS=12

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM_NAME=Work Report
MAIL_FROM_EMAIL=noreply@workreport.online

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# admin view endpoint key (x-admin-key header)
ADMIN_API_KEY=change_this_admin_key
ADMIN_OWNER_EMAILS=owner@workreport.online

FIREBASE_PROJECT_ID=work-report-fe3da
# Either provide JSON string OR local file path
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
